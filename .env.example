# FinPath AI — environment variable template
# Copy this file to .env and fill in your values.
# The .env file is gitignored and must never be committed.
#
# NOTE: The ADK (orchestrate CLI) uses its own auth config at ~/.wxo/ —
# populated by running `orchestrate env activate finpath`.
# These variables are provided for reference / alternative REST-based clients
# and are NOT required for the Streamlit UI which uses the ADK directly.

# IBM Cloud API key (used to obtain MCSP tokens for Orchestrate)
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# Full URL of your Orchestrate instance, e.g.:
# https://api.jp-tok.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
ORCHESTRATE_INSTANCE_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>

# The deployed agent ID for finpath_agent (obtained from `orchestrate agents list`)
FINPATH_AGENT_ID=your_agent_id_here
