# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .streamlit/secrets.toml and fill in real values before
# deploying to Streamlit Community Cloud.
#
# DO NOT commit secrets.toml — it is listed in .gitignore.
# This example file contains ONLY placeholders and is safe to commit.
#
# On Streamlit Community Cloud you can paste these key/value pairs directly
# into the "Secrets" panel in your app settings instead of uploading a file.
# ─────────────────────────────────────────────────────────────────────────────

# IBM Cloud API key — used to authenticate with watsonx Orchestrate.
# Obtain from https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY = "your_ibm_cloud_api_key_here"

# Full URL of your Orchestrate instance, e.g.:
# https://api.jp-tok.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
ORCHESTRATE_INSTANCE_URL = "https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>"
